{
  "name": "wayfinder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "install:all": "npm --prefix server install && npm --prefix client install",
    "dev": "node scripts/dev-local.js",
    "dev:mongo": "powershell -ExecutionPolicy Bypass -File scripts/start-local-mongodb.ps1",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "audit:jaipur": "node mock_ai_pipeline/runJaipurSeedAudit.js",
    "audit:adaptive": "node mock_ai_pipeline/runAdaptivePreferenceDemo.js",
    "evaluate": "node mock_ai_pipeline/runEvaluation.js"
  }
}
